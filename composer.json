{
    "name": "shazzoo/content-studio-laravel",
    "description": "Shows the blog articles from the Content Studio Strategy Engine on a Laravel site.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Shazzoo\\ContentStudio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shazzoo\\ContentStudio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shazzoo\\ContentStudio\\ContentStudioServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
